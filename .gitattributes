# Normaliza finais de linha no clone (Windows / Linux / macOS)
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ini  text eol=lf

# VBScript no Elipse E3 espera CRLF no Windows
*.vbs  text eol=crlf
*.ps1  text eol=crlf
